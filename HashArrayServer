const express = require('express');            // Biblioteca para criar um servidor
const bodyParser = require('body-parser');     // Biblioteca que pega o corpo da requisição(frontend)
const bcrypt = require('bcrypt');              // Biblioteca para utilizar o metodo de descriptografia ou criptografia.

const app = express();    // Instancia do servidor.

// Utilizando, recebendo o corpo da requisição(formulario vindo do frontend), Sim.
app.use(bodyParser.urlencoded({ extended: true }));
app.use(bodyParser.json());  // Converte os dados em JSON

// Lista carregando um Objeto com credencias para o login 200!
const credentials = [
  { username: 'admin', passwordHashes: '$2b$10$b9RBWc9EJhtpt5rcaQVFQ.ewdxkx6q7l9FMapXSqLV6dUzM4nGCbu' }
];

app.get('/', (request, response) => {
  response.statusCode = 200;
  response.setHeader('Content-Type', 'text/html');  // Tipo de cabeçalho
  response.send(`

  <!DOCYTYPE html>
  <html lang='en'>
