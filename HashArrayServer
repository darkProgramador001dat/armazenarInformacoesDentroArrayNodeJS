// ROTA POST 
app.post('/login', (request, response) => {
  const { username, password } = request.body;    // receber os dados do frontend.

  const compareCredentials = credentials.find(u => u.username === username)    // Criando uma instancia e realizando a buscar dentro do Objeto, instanciando uma igualdade da requisiçao e objeto.
  if(compareCredentials) // Realizando a comparação vinda do frontend com o Objeto
  {
    bcrypt.compare(password, compareCredentials.passwordHashes, (err, result) => {  
      if(result)  // Callback de sucesso.
      {
        response.status(200).send('<h2> Login authorized 200! </h2>');
      } else // Senha incorreta.
      {
        response.status(401).send('<h3> username or password invalid </h3>');
      }
    });
  } else  // Nao encontrado no Objeto
  {
    response.status(401).send('<h3> Error in DB_Array not found username </h3>');
  }
});

// Iniciando o servidor, e vinculando a porta.
const PORT = 5500;
app.listen(PORT, () => {
  console.clear();
  console.log(`[+] server running, http://localhost:${PORT}/`);
});
